{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "cleanUrls": true,
  "trailingSlash": true,
  "redirects": [
    {
      "source": "/nuestro-menu/",
      "destination": "/menu/",
      "permanent": true
    },
    {
      "source": "/almuerzos-especiales/",
      "destination": "/menu/#almuerzo",
      "permanent": true
    },
    {
      "source": "/nuestro-restaurante/",
      "destination": "/visita/",
      "permanent": true
    },
    {
      "source": "/ubicacion/",
      "destination": "/visita/",
      "permanent": true
    },
    {
      "source": "/contactanos/",
      "destination": "/visita/",
      "permanent": true
    },
    {
      "source": "/trabajando/",
      "destination": "/",
      "permanent": true
    },
    {
      "source": "/hello-world/",
      "destination": "/",
      "permanent": true
    },
    {
      "source": "/category/:rest*",
      "destination": "/",
      "permanent": true
    },
    {
      "source": "/author/:rest*",
      "destination": "/",
      "permanent": true
    },
    {
      "source": "/blocks/:rest*",
      "destination": "/",
      "permanent": true
    }
  ],
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "Content-Security-Policy",
          "value": "default-src 'self'; script-src 'self' 'sha256-ExjvxQW7reemNoZhZy+A6O9NCYws5bjR8VBIanusBGU='; style-src 'self'; img-src 'self' data:; font-src 'self'; connect-src 'self'; frame-ancestors 'none'; base-uri 'self'; form-action 'self'; object-src 'none'; upgrade-insecure-requests"
        },
        {
          "key": "X-Content-Type-Options",
          "value": "nosniff"
        },
        {
          "key": "Referrer-Policy",
          "value": "strict-origin-when-cross-origin"
        },
        {
          "key": "Permissions-Policy",
          "value": "camera=(), microphone=(), geolocation=(), payment=()"
        },
        {
          "key": "Strict-Transport-Security",
          "value": "max-age=63072000; includeSubDomains"
        },
        {
          "key": "X-Robots-Tag",
          "value": "noindex, nofollow"
        }
      ]
    },
    {
      "source": "/assets/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, immutable"
        }
      ]
    },
    {
      "source": "/fuentes/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, immutable"
        }
      ]
    },
    {
      "source": "/media/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=604800, stale-while-revalidate=86400"
        }
      ]
    },
    {
      "source": "/eventos/(.*).ics",
      "headers": [
        {
          "key": "Content-Type",
          "value": "text/calendar; charset=utf-8"
        }
      ]
    }
  ]
}
